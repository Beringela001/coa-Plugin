<phpunit bootstrap="tests/bootstrap.php" colors="true" convertDeprecationsToExceptions="false">
  <testsuites>
    <testsuite name="Pep Select COA Archive">
      <directory suffix=".php">tests</directory>
      <exclude>tests/bootstrap.php</exclude>
    </testsuite>
  </testsuites>
</phpunit>
