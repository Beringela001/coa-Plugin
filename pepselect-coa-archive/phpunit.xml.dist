<?xml version="1.0"?>
<phpunit bootstrap="tests/bootstrap.php" colors="true" convertDeprecationsToExceptions="false">
  <testsuites>
    <testsuite name="Pep Select COA Archive">
      <directory suffix=".php">tests</directory>
      <exclude>tests/bootstrap.php</exclude>
      <exclude>tests/test-report-notes-standalone.php</exclude>
      <!-- Standalone contracts define WordPress stubs; run them separately. -->
      <exclude>tests/qr-correction-contract.php</exclude>
      <exclude>tests/report-evidence-contract.php</exclude>
      <exclude>tests/report-logo-url-contract.php</exclude>
      <exclude>tests/report-navigation-render-contract.php</exclude>
      <exclude>tests/report-refinement-contract.php</exclude>
    </testsuite>
  </testsuites>
</phpunit>
