# Build artifacts — packaged plugin zips are produced from source, not tracked
*.zip
zips/

# Local working copies of deployed/reference builds
.live-*/
.pristine-*/

# Composer dev dependencies (PHPUnit and the WordPress polyfills)
vendor/
composer.lock

# Local agent session settings
.claude/

# Local audit downloads and preview runtime output.
tmp/

# Regenerable Graphify cache (retain the graph and manifest).
graphify-out/cache/
